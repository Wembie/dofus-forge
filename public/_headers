# Static assets only: responses built by the Worker get the same set from
# src/worker/securityHeaders.ts, and headers.test.ts keeps the two identical.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://pagead2.googlesyndication.com https://*.adtrafficquality.google https://challenges.cloudflare.com https://static.cloudflareinsights.com https://www.googletagmanager.com https://fundingchoicesmessages.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://wkllwjxodqxhiptjaccj.supabase.co wss://wkllwjxodqxhiptjaccj.supabase.co https://assets.dofusforge.com https://api.dofusdu.de https://pagead2.googlesyndication.com https://*.adtrafficquality.google https://cloudflareinsights.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://fundingchoicesmessages.google.com; frame-src https://challenges.cloudflare.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://*.adtrafficquality.google; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Vite puts a content hash in every file name under /assets/, so a changed
# file is a new URL: these never need revalidating (default is max-age=0).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Web fonts carry a hand-set version in their name (-v04.woff2), not a
# content hash, so a month rather than immutable: ship a changed font under
# a new name, or returning visitors keep the old one up to 30 days.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Logo, favicons and share cards keep their names across edits, so a day
# fresh plus a week of background revalidation, not immutable.
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# UI strings. The app requests them with ?v=<app version> (fetchBackend.ts),
# so a release is a new URL; the bare path still revalidates within a day.
/locales/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Game data JSON (items/sets/index per locale). Most loads append ?v=<bust>
# from loadVersion() (src/data/loaders.ts), so the URL itself changes when
# the data does — but Cloudflare's _headers matching ignores query strings
# and a plain reload can still hit the bare path, so this stays short-lived
# and revalidated rather than immutable.
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The one file every client re-reads to decide if its cached data is stale:
# must never be served long-lived or the staleness check itself goes stale.
/data/version.json
  Cache-Control: public, max-age=60, must-revalidate

# Chrome's private prefetch proxy reads this before prefetching the site from
# Google results; it must be served with its own media type.
/.well-known/traffic-advice
  Content-Type: application/trafficadvice+json
