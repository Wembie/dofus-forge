,"effects":[{"element":"earth","min":23,"max":26,"kind":"damage"}],"critEffects":[{"element":"earth","min":28,"max":31,"kind":"damage"}],"buffs":["-3 MP (1T)"]},{"grade":2,"ap":4,"minRange":2,"maxRange":7,"maxPerTurn":3,"critChance":20,"effects":[{"element":"earth","min":28,"max":31,"kind":"damage"}],"critEffects":[{"element":"earth","min":33,"max":37,"kind":"damage"}],"buffs":["-3 MP (1T)"]},{"grade":3,"ap":4,"minRange":2,"maxRange":8,"maxPerTurn":3,"critChance":20,"effects":[{"element":"earth","min":31,"max":35,"kind":"damage"}],"critEffects":[{"element":"earth","min":37,"max":42,"kind":"damage"}],"buffs":["-3 MP (1T)"]}],"description":"Inflicts Earth damage and removes MP."},{"id":13390,"name":"Retention","element":"air","is_variant":true,"image_url":"/data/spells/img/sort_12422-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":3,"maxPerTurn":3,"critChance":15,"effects":[{"element":"air","min":27,"max":31,"kind":"steal"}],"critEffects":[{"element":"air","min":33,"max":37,"kind":"steal"}],"buffs":["-2 AP (1T)"]}],"description":"Steals HP in the Air element and removes AP."},{"id":13396,"name":"Boliche","element":"water","is_variant":false,"image_url":"/data/spells/img/sort_12434-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":4,"maxPerTurn":3,"critChance":25,"effects":[{"element":"water","min":23,"max":25,"kind":"damage"},{"element":"neutral","min":3,"max":3,"kind":"push"}],"critEffects":[{"element":"water","min":27,"max":30,"kind":"damage"}],"buffs":["Advances by 3 cell"]},{"grade":2,"ap":3,"minRange":1,"maxRange":5,"maxPerTurn":3,"critChance":25,"effects":[{"element":"water","min":29,"max":32,"kind":"damage"},{"element":"neutral","min":3,"max":3,"kind":"push"}],"critEffects":[{"element":"water","min":35,"max":38,"kind":"damage"}],"buffs":["Advances by 4 cell"]}],"description":"Moves the caster closer to the target, inflicts Water damage on enemies, and repels the target."},{"id":14681,"name":"Ronda","element":"earth","is_variant":true,"image_url":"/data/spells/img/sort_12446-48.png","levels":[{"grade":1,"ap":4,"minRange":0,"maxRange":1,"maxPerTurn":1,"critChance":15,"effects":[{"element":"earth","min":38,"max":42,"kind":"damage"}],"critEffects":[{"element":"earth","min":46,"max":50,"kind":"damage"}],"buffs":["Attracts by 2 cell"]}],"description":"Inflicts Earth damage on enemies and attracts the targets towards the caster in an area of effect."},{"id":13402,"name":"Ardour","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_12412-48.png","levels":[{"grade":1,"ap":2,"minRange":0,"maxRange":5,"maxPerTurn":0,"critChance":0,"effects":[]},{"grade":2,"ap":2,"minRange":0,"maxRange":6,"maxPerTurn":0,"critChance":0,"effects":[]}],"description":"Makes the targeted ally Unlockable or makes the targeted enemy Unhealable."},{"id":13404,"name":"Masquerade","element":"neutral","is_variant":true,"image_url":"/data/spells/img/sort_12441-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":1,"maxPerTurn":0,"critChance":0,"effects":[{"element":"neutral","min":25,"max":0,"kind":"damage"},{"element":"neutral","min":25,"max":0,"kind":"damage"},{"element":"neutral","min":25,"max":0,"kind":"damage"},{"element":"neutral","min":25,"max":0,"kind":"damage"}]}],"description":"Inflicts Neutral damage on the caster and the target:\n• The damage inflicted on the target depends on the caster's remaining health.\n• The damage inflicted on the caster depends on how much health they are missing.\n• The effects are inverted if the caster is below 50% health.\n\nOn the caster: switches places with their Grimacing Mask."},{"id":13399,"name":"Trance","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_12416-48.png","levels":[{"grade":1,"ap":3,"minRange":0,"maxRange":1,"maxPerTurn":0,"critChance":25,"effects":[],"buffs":["-75% HP (2T)","450% of level to shield (2T)","225% of level to shield (2T)"]},{"grade":2,"ap":3,"minRange":0,"maxRange":1,"maxPerTurn":0,"critChance":25,"effects":[],"buffs":["-70% HP (2T)","450% of level to shield (2T)","225% of level to shield (2T)"]}],"description":"Sacrifices some of the caster's health to apply a shield on allies in an area of effect.\nThe shield is halved on summons."},{"id":13426,"name":"Neurosis","element":"neutral","is_variant":true,"image_url":"/data/spells/img/sort_12436-48.png","levels":[{"grade":1,"ap":2,"minRange":0,"maxRange":6,"maxPerTurn":0,"critChance":0,"effects":[],"buffs":["250 Power (2T)"]}],"description":"Increases the targeted ally's Power and applies the Gravity state to the target."},{"id":13424,"name":"Grimace","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_12417-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":1,"maxPerTurn":0,"critChance":0,"effects":[{"element":"neutral","min":2,"max":2,"kind":"push"},{"element":"neutral","min":2,"max":2,"kind":"mp_gain"}],"buffs":["120% of level to shield (2T)","Attracts by 2 cell","13424: cooldown set to #3 <sprite name=\"tour\">","Teleports to the targeted cell"]},{"grade":2,"ap":3,"minRange":1,"maxRange":1,"maxPerTurn":0,"critChance":0,"effects":[{"element":"neutral","min":2,"max":2,"kind":"push"},{"element":"neutral","min":2,"max":2,"kind":"mp_gain"}],"buffs":["120% of level to shield (2T)","Attracts by 2 cell","13424: cooldown set to #3 <sprite name=\"tour\">","Teleports to the targeted cell"]}],"description":"Summons a biddable Grimacing Mask that locks enemies and shares its damage with its summoner as long as it is alive.\nWhen an enemy is locked by the Mask, the mask and its summoner gain shield.\n\nThe Grimacing Mask also applies effects depending on the mask worn by its summoner:\n• Intrepid: attracts entities in an area of effect around it.\n• Coward: increases its MP.\n• Psychopath: repels adjacent entities.\n\nThe Mask is teleported to the targeted cell if the spell is cast when it is alive.\nWhen it dies, the spell's cooldown period is set to 2 turns."},{"id":13385,"name":"Diffraction","element":"neutral","is_variant":true,"image_url":"/data/spells/img/sort_12442-48.png","levels":[{"grade":1,"ap":3,"minRange":0,"maxRange":0,"maxPerTurn":0,"critChance":0,"effects":[],"buffs":["450% of level to shield (2T)","225% of level to shield (2T)","250% of level to shield (2T)","125% of level to shield (2T)","50% of level to shield (2T)","25% of level to shield (2T)"]}],"description":"Applies shield on everyone depending on distance from the caster:\n• 0 to 5 cells, 450% of level as shield.\n• 6 to 11 cells, 250% of level as shield.\n• 12 or more cells, 50% of level as shield.\nThe shield is halved on summons."},{"id":18651,"name":"Carnavalo","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_12420-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":3,"maxPerTurn":0,"critChance":15,"effects":[{"element":"neutral","min":19,"max":23,"kind":"damage"},{"element":"neutral","min":29,"max":33,"kind":"damage"},{"element":"neutral","min":1,"max":1,"kind":"push"}],"critEffects":[{"element":"neutral","min":24,"max":28,"kind":"damage"},{"element":"neutral","min":34,"max":38,"kind":"damage"}],"buffs":["100% of level to shield (2T)","300% of level to shield (2T)"]},{"grade":2,"ap":3,"minRange":1,"maxRange":3,"maxPerTurn":0,"critChance":15,"effects":[{"element":"neutral","min":24,"max":28,"kind":"damage"},{"element":"neutral","min":39,"max":43,"kind":"damage"},{"element":"neutral","min":1,"max":1,"kind":"push"}],"critEffects":[{"element":"neutral","min":29,"max":34,"kind":"damage"},{"element":"neutral","min":45,"max":50,"kind":"damage"}],"buffs":["100% of level to shield (2T)","300% of level to shield (2T)"]}],"description":"Applies a shield on the caster, inflicts damage in the caster's best attack element on enemies, and repels the target.\nThe effects become stronger based on the mask worn by the caster:\n• Intrepid state: shield is strongest.\n• Cowardly state: pushback is strongest.\n• Psychopathic state: damage is strongest.\n\nEach mask change reduces the spell's cooldown period by one turn."},{"id":18650,"name":"Transfiguration","element":"neutral","is_variant":true,"image_url":"/data/spells/img/sort_12444-48.png","levels":[{"grade":1,"ap":2,"minRange":1,"maxRange":6,"maxPerTurn":0,"critChance":0,"effects":[],"buffs":["-20% final damage (2T)","-10% Ranged Resistance (2T)","-10% Melee Resistance (2T)"]}],"description":"Applies the Transfiguration state on the caster and the targeted enemy, and applies effects on the enemy depending on which mask is worn:\n• Intrepid state: reduces final damage inflicted.\n• Cowardly state: reduces ranged resistances.\n• Psychopathic state: reduces close-combat resistances.\nStacking is shared among effects.\n\nEach mask change reduces the spell's cooldown period by 1 turn and reapplies the spell's effects if the caster is in the Transfiguration state."}]}