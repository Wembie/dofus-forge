' special spells on the target.\n\nInflicts Water, Earth, Air and Fire damage."},{"id":13822,"name":"Torrent","element":"water","is_variant":false,"image_url":"/data/spells/img/sort_12636-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":4,"maxPerTurn":3,"critChance":10,"effects":[{"element":"water","min":22,"max":25,"kind":"damage"},{"element":"neutral","min":4,"max":4,"kind":"push"}],"critEffects":[{"element":"water","min":26,"max":30,"kind":"damage"}],"buffs":["Attracts by 6 cell"]},{"grade":2,"ap":3,"minRange":1,"maxRange":4,"maxPerTurn":3,"critChance":10,"effects":[{"element":"water","min":27,"max":30,"kind":"damage"},{"element":"neutral","min":4,"max":4,"kind":"push"}],"critEffects":[{"element":"water","min":32,"max":36,"kind":"damage"}],"buffs":["Attracts by 6 cell"]},{"grade":3,"ap":3,"minRange":1,"maxRange":4,"maxPerTurn":3,"critChance":10,"effects":[{"element":"water","min":30,"max":34,"kind":"damage"},{"element":"neutral","min":4,"max":4,"kind":"push"}],"critEffects":[{"element":"water","min":36,"max":41,"kind":"damage"}],"buffs":["Attracts by 6 cell"]}],"description":"Inflicts Water damage on enemies and moves the target based on the Tide:\n• Low Tide: attracts the target.\n• High Tide: repels the target.\n\nA given target can only be affected once by the movement of a Tide during the current turn."},{"id":13861,"name":"Harmattan","element":"air","is_variant":true,"image_url":"/data/spells/img/sort_12661-48.png","levels":[{"grade":1,"ap":4,"minRange":1,"maxRange":6,"maxPerTurn":1,"critChance":20,"effects":[{"element":"air","min":31,"max":35,"kind":"damage"},{"element":"neutral","min":2,"max":2,"kind":"push"}],"critEffects":[{"element":"air","min":37,"max":42,"kind":"damage"}]}],"description":"Repels the target and inflicts Air damage on enemies.\nRebounds on entities adjacent to the target."},{"id":13836,"name":"First Aid","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_13160-48.png","levels":[{"grade":1,"ap":3,"minRan