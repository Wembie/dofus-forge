,"max":2,"kind":"mp_gain"}]}],"description":"Increases the target's MP, makes it Unshakable and applies the Bark state to it:\n• Removes the states and increases Rage if the target suffers close-combat damage."},{"id":13803,"name":"Gnaw","element":"neutral","is_variant":true,"image_url":"/data/spells/img/sort_12081-48.png","levels":[{"grade":1,"ap":2,"minRange":0,"maxRange":3,"maxPerTurn":0,"critChance":0,"effects":[],"buffs":["80 Power (2T)","40 Pushback Damage (2T)","20 Lock (2T)","30 Power (2T)","20 Pushback Damage (2T)","10 Lock (2T)"]}],"description":"Increases the targeted ally's Power, Pushback Damage and Lock and applies the Gnaw state to them:\n• Increases these same characteristics on the caster if the target suffers damage (stackable 5 times).\n\nIncreases Rage."},{"id":13765,"name":"Bloodhound","element":"air","is_variant":false,"image_url":"/data/spells/img/sort_12053-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":3,"maxPerTurn":3,"critChance":10,"effects":[{"element":"air","min":23,"max":25,"kind":"damage"}],"critEffects":[{"element":"air","min":27,"max":30,"kind":"damage"}],"buffs":["Attracts by 2 cell"]},{"grade":2,"ap":3,"minRange":1,"maxRange":3,"maxPerTurn":3,"critChance":10,"effects":[{"element":"air","min":28,"max":31,"kind":"damage"}],"critEffects":[{"element":"air","min":34,"max":37,"kind":"damage"}],"buffs":["Attracts by 2 cell"]}],"description":"Inflicts Air damage.\nOn the Prey: draws entities toward the target in an area of effect before applying effects.\n\nThe spell is not subject to casting conditions in Animal Form."},{"id":13753,"name":"Tetanisation","element":"fire","is_variant":true,"image_url":"/data/spells/img/sort_12057-48.png","levels":[{"grade":1,"ap":4,"minRange":1,"maxRange":4,"maxPerTurn":2,"critChance":25,"effects":[{"element":"fire","min":41,"max":46,"kind":"damage"}],"critEffects":[{"element":"fire","min":49,"max":55,"kind":"damage"}],"buffs":["-3 MP (1T)"]}],"description":"Inflicts Fire damage and reduces MP.\n\nIncreases Rage (requires a target)."},{"id":13749,"name":"Sniff","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_12054-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":63,"maxPerTurn":0,"critChance":0,"effects":[],"buffs":["Teleports to the targeted cell"]},{"grade":2,"ap":3,"minRange":1,"maxRange":63,"maxPerTurn":0,"critChance":0,"effects":[],"buffs":["Teleports to the targeted cell"]}],"description":"Teleports the caster to the first available cell adjacent to the Prey.\n\nIf the Prey is in the area of effect: teleports the caster to the targeted cell.\n\nRequires and reduces Rage."},{"id":13805,"name":"Doggedness","element":"neutral","is_variant":true,"image_url":"/data/spells/img/sort_12083-48.png","levels":[{"grade":1,"ap":2,"minRange":1,"maxRange":5,"maxPerTurn":0,"critChance":0,"effects":[],"buffs":["x115% damage sustained","Teleports to the targeted cell"]}],"description":"Applies the Gravity state on the targeted enemy.\nIf the enemy is the Prey:\n• Also increases the damage suffered by the target.\n• Teleports the caster's Yappers to be adjacent to them.\n\nIncreases Rage (requires a target)."},{"id":14357,"name":"Call of the Pack","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_12056-48.png","levels":[{"grade":1,"ap":2,"minRange":0,"maxRange":5,"maxPerTurn":0,"critChance":0,"effects":[{"element":"neutral","min":10,"max":0,"kind":"erosion","turns":1}],"buffs":["13774: -#3 <sprite name=\"tour\"> cooldown","Attracts by 2 cell","Attracts by 4 cell"]},{"grade":2,"ap":2,"minRange":0,"maxRange":6,"maxPerTurn":0,"critChance":0,"effects":[{"element":"neutral","min":10,"max":0,"kind":"erosion","turns":1}],"buffs":["13774: -#3 <sprite name=\"tour\"> cooldown","Attracts by 2 cell","Attracts by 4 cell"]}],"description":"Reduces the cooldown period of the Yapper Launcher spell for the caster.\n• If the target is the caster: attracts all allies towards the target.\n• If the target is the Prey: erodes the target and attracts all allies towards it.\nThe attraction is greater if the target is the Prey."},{"id":14321,"name":"New Moon","element":"neutral","is_variant":true,"image_url":"/data/spells/img/sort_12084-48.png","levels":[{"grade":1,"ap":2,"minRange":0,"maxRange":0,"maxPerTurn":0,"critChance":0,"effects":[],"buffs":["Effect duration: -2"]}],"description":"Reduces the duration of effects on the caster and transforms them into a Beast.\n\nCannot be used in Animal Form."}]}