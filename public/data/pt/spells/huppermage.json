r para aplicar efeitos e um estado elementar nos inimigos em zona de acordo com o elemento dela:\n• <sprite name=\"terre\"> Terra: reduz a duração dos efeitos nos alvos.\n• <sprite name=\"feu\"> Fogo: reduz as curas recebidas pelos alvos.\n• <sprite name=\"eau\"> Água: erode os alvos.\n• <sprite name=\"air\"> Ar: cura os atacantes dos alvos.\n\nPode gerar {{spell,23876,1::Combinações Elementares}}."},{"id":32033,"name":"Supernova","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_15327-48.png","levels":[{"grade":1,"ap":3,"minRange":0,"maxRange":5,"maxPerTurn":2,"critChance":10,"effects":[{"element":"neutral","min":15,"max":17,"kind":"damage"},{"element":"neutral","min":7,"max":9,"kind":"damage"}],"critEffects":[{"element":"neutral","min":18,"max":20,"kind":"damage"},{"element":"neutral","min":10,"max":12,"kind":"damage"}],"buffs":["Duração dos efeitos: -1","Coloca uma runa (2T)"]},{"grade":2,"ap":3,"minRange":0,"maxRange":6,"maxPerTurn":2,"critChance":10,"effects":[{"element":"neutral","min":19,"max":21,"kind":"damage"},{"element":"neutral","min":9,"max":11,"kind":"damage"}],"critEffects":[{"element":"neutral","min":23,"max":25,"kind":"damage"},{"element":"neutral","min":12,"max":14,"kind":"damage"}],"buffs":["Duração dos efeitos: -1","Coloca uma runa (2T)"]}],"description":"Reduz a duração dos efeitos no alvo e inflige danos aos inimigos nos melhores e nos piores elementos do lançador.\nColoca uma runa do pior elemento.\n\nPode gerar {{spell,23876,1::Combinações Elementares}}."},{"id":14342,"name":"Torrente Arcana","element":"mixed","is_variant":true,"image_url":"/data/spells/img/sort_12576-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":8,"maxPerTurn":0,"critChance":10,"effects":[{"element":"air","min":2,"max":0,"kind":"damage"},{"element":"earth","min":2,"max":0,"kind":"damage"},{"element":"fire","min":2,"max":0,"kind":"damage"},{"element":"water","min":2,"max":0,"kind":"damage"},{"element":"neutral","min":2,"max":0,"kind":"spe