ects":[{"element":"earth","min":38,"max":42,"kind":"damage"}],"critEffects":[{"element":"earth","min":46,"max":50,"kind":"damage"}],"buffs":["Atrai por 2 célula"]}],"description":"Inflige danos de terra aos inimigos e atrai os alvos para o lançador em zona."},{"id":13402,"name":"Ardor","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_12412-48.png","levels":[{"grade":1,"ap":2,"minRange":0,"maxRange":5,"maxPerTurn":0,"critChance":0,"effects":[]},{"grade":2,"ap":2,"minRange":0,"maxRange":6,"maxPerTurn":0,"critChance":0,"effects":[]}],"description":"Deixa o aliado visado Imbloqueável ou o inimigo visado Incurável."},{"id":13404,"name":"Mascarada","element":"neutral","is_variant":true,"image_url":"/data/spells/img/sort_12441-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":1,"maxPerTurn":0,"critChance":0,"effects":[{"element":"neutral","min":25,"max":0,"kind":"damage"},{"element":"neutral","min":25,"max":0,"kind":"damage"},{"element":"neutral","min":25,"max":0,"kind":"damage"},{"element":"neutral","min":25,"max":0,"kind":"damage"}]}],"description":"Inflige danos neutros ao lançador e ao alvo:\n• Os danos ao alvo dependem da vida restante do lançador.\n• Os danos ao lançador dependem de sua vida perdida.\n• Os efeitos se invertem se o lançador estiver com menos de 50% da vida.\n\nNo lançador: troca de lugar com sua Máscara Careteira."},{"id":13399,"name":"Transe","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_12416-48.png","levels":[{"grade":1,"ap":3,"minRange":0,"maxRange":1,"maxPerTurn":0,"critChance":25,"effects":[],"buffs":["-75% de PV (2T)","450% do nível em escudo (2T)","225% do nível em escudo (2T)"]},{"grade":2,"ap":3,"minRange":0,"maxRange":1,"maxPerTurn":0,"critChance":25,"effects":[],"buffs":["-70% de PV (2T)","450% do nível em escudo (2T)","225% do nível em escudo (2T)"]}],"description":"Sacrifica uma parte da vida do lançador para aplicar um escudo nos aliados em zona.\nO escudo é reduzido pela metade nas invocações."},{"id":13426,"name":"Neurose","element":"neutral","is_variant":true,"image_url":"/data/spells/img/sort_12436-48.png","levels":[{"grade":1,"ap":2,"minRange":0,"maxRange":6,"maxPerTurn":0,"critChance":0,"effects":[],"buffs":["250 Potência (2T)"]}],"description":"Aumenta a potência do aliado visado e aplica o estado Gravidade no alvo."},{"id":13424,"name":"Careta","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_12417-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":1,"maxPerTurn":0,"critChance":0,"effects":[{"element":"neutral","min":2,"max":2,"kind":"push"},{"element":"neutral","min":2,"max":2,"kind":"mp_gain"}],"buffs":["120% do nível em escudo (2T)","Atrai por 2 célula","13424: intervalo de relançamento fixado em #3 <sprite name=\"tour\">","Teletransporta para a célula visada"]},{"grade":2,"ap":3,"minRange":1,"maxRange":1,"maxPerTurn":0,"critChance":0,"effects":[{"element":"neutral","min":2,"max":2,"kind":"push"},{"element":"neutral","min":2,"max":2,"kind":"mp_gain"}],"buffs":["120% do nível em escudo (2T)","Atrai por 2 célula","13424: intervalo de relançamento fixado em #3 <sprite name=\"tour\">","Teletransporta para a célula visada"]}],"description":"Invoca uma Máscara Careteira controlável que bloqueia os inimigos e compartilha os danos com o invocador enquanto ele estiver vivo.\nQuando um inimigo é bloqueado pela Máscara, ela e seu invocador ganham escudo.\n\nA Máscara Careteira também se aplica efeitos em função da máscara portada pelo invocador:\n• Intrépido: atrai as entidades em zona ao redor dele.\n• Covarde: aumenta seus PM.\n• Psicopata: empurra as entidades em contato com ela.\n\nA Máscara será teletransportada para a célula visada se o feitiço for lançado outra vez enquanto ela estiver viva.\nAo morrer, o intervalo de relançamento do feitiço é fixado em 2 turnos."},{"id":13385,"name":"Difração","element":"neutral","is_variant":true,"image_url":"/data/spells/img/sort_12442-48.png","levels":[{"gra