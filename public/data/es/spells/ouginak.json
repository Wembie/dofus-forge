":2,"kind":"mp_gain"}]},{"grade":2,"ap":2,"minRange":0,"maxRange":4,"maxPerTurn":0,"critChance":0,"effects":[{"element":"neutral","min":2,"max":2,"kind":"mp_gain"}]}],"description":"Aumenta los PM del objetivo, lo vuelve inquebrantable y le aplica el estado Ladrido:\n• Retira los estados y aumenta la rabia si el objetivo sufre daños en cuerpo a cuerpo."},{"id":13803,"name":"Enojo","element":"neutral","is_variant":true,"image_url":"/data/spells/img/sort_12081-48.png","levels":[{"grade":1,"ap":2,"minRange":0,"maxRange":3,"maxPerTurn":0,"critChance":0,"effects":[],"buffs":["80 potencia (daños generales) (2T)","40 de daño de empuje (2T)","20 placaje (2T)","30 potencia (daños generales) (2T)","20 de daño de empuje (2T)","10 placaje (2T)"]}],"description":"Aumenta la potencia, los daños de empuje y el placaje del aliado objetivo, y le aplica el estado Enojo:\n• Aumenta estas mismas características en el lanzador si el objetivo sufre daños (acumulable 5 veces).\n\nAumenta la rabia."},{"id":13765,"name":"Sabueso","element":"air","is_variant":false,"image_url":"/data/spells/img/sort_12053-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":3,"maxPerTurn":3,"critChance":10,"effects":[{"element":"air","min":23,"max":25,"kind":"damage"}],"critEffects":[{"element":"air","min":27,"max":30,"kind":"damage"}],"buffs":["Atrae 2 casilla"]},{"grade":2,"ap":3,"minRange":1,"maxRange":3,"maxPerTurn":3,"critChance":10,"effects":[{"element":"air","min":28,"max":31,"kind":"damage"}],"critEffects":[{"element":"air","min":34,"max":37,"kind":"damage"}],"buffs":["Atrae 2 casilla"]}],"description":"Ocasiona daños de aire.\nAtrae a las entidades hacia el objetivo en zona antes de aplicar los efectos si este es la presa.\n\nEl hechizo no depende de las restricciones de lanzamiento bajo Forma Bestial."},{"id":13753,"name":"Tetanización","element":"fire","is_variant":true,"image_url":"/data/spells/img/sort_12057-48.png","levels":[{"grade":1,"ap":4,"minRange":1,"maxRange":4,"maxPerTurn":2,"cri