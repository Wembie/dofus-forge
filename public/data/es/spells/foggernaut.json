a: repele a los objetivos desde el lanzador."},{"id":13873,"name":"Sónar","element":"neutral","is_variant":false,"image_url":"/data/spells/img/sort_13140-48.png","levels":[{"grade":1,"ap":3,"minRange":1,"maxRange":4,"maxPerTurn":2,"critChance":10,"effects":[{"element":"neutral","min":5,"max":7,"kind":"damage"},{"element":"neutral","min":2,"max":2,"kind":"push"}],"critEffects":[{"element":"neutral","min":8,"max":10,"kind":"damage"}]},{"grade":2,"ap":3,"minRange":1,"maxRange":4,"maxPerTurn":2,"critChance":10,"effects":[{"element":"neutral","min":8,"max":10,"kind":"damage"},{"element":"neutral","min":2,"max":2,"kind":"push"}],"critEffects":[{"element":"neutral","min":11,"max":13,"kind":"damage"}]},{"grade":3,"ap":3,"minRange":1,"maxRange":4,"maxPerTurn":2,"critChance":10,"effects":[{"element":"neutral","min":11,"max":13,"kind":"damage"},{"element":"neutral","min":2,"max":2,"kind":"push"}],"critEffects":[{"element":"neutral","min":14,"max":16,"kind":"damage"}]}],"description":"Activa los hechizos especiales de las torretas ofensivas del lanzador en el enemigo objetivo.\n\nOcasiona daños con el mejor elemento del lanzador a los enemigos.\n\nEn un aliado: repele a los objetivos desde el centro y desvela a los invisibles en zona.\nNo afecta al lanzador."},{"id":13835,"name":"Emboscada","element":"mixed","is_variant":true,"image_url":"/data/spells/img/sort_12650-48.png","levels":[{"grade":1,"ap":4,"minRange":2,"maxRange":6,"maxPerTurn":1,"critChance":5,"effects":[{"element":"water","min":7,"max":9,"kind":"damage"},{"element":"earth","min":7,"max":9,"kind":"damage"},{"element":"fire","min":7,"max":9,"kind":"damage"},{"element":"air","min":7,"max":9,"kind":"damage"}],"critEffects":[{"element":"water","min":10,"max":12,"kind":"damage"},{"element":"earth","min":10,"max":12,"kind":"damage"},{"element":"fire","min":10,"max":12,"kind":"damage"},{"element":"air","min":10,"max":12,"kind":"damage"}]}],"description":"Activa los hechizos especiales de las torretas ofensivas del lanzado