# Copy to .env (gitignored) and fill in from Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key


# Optional: public domain of the assets R2 bucket (wrangler.jsonc). Set, item
# icons (items/) and character assets (chars/) load straight from Cloudflare's
# cache instead of invoking the Worker for every file. Unset, the Worker
# routes are used.
# VITE_ASSETS_URL=https://assets.dofusforge.com/
