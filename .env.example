# Copy to .env (gitignored) and fill in from Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key


# Optional: public domains of the R2 buckets (wrangler.jsonc). Set, item icons
# and character assets load straight from Cloudflare's cache instead of
# invoking the Worker for every file. Unset, the Worker routes are used.
# VITE_ITEM_ASSETS_URL=https://items.dofusforge.com/
# VITE_CHAR_ASSETS_URL=https://chars.dofusforge.com/
