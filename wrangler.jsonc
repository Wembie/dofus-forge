{
  "name": "dofus-forge",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    // Not "single-page-application": that would answer every unknown path
    // with index.html, which is now the prerendered English home page.
    // Unmatched paths reach the Worker instead, which serves React Router's
    // __spa-fallback.html for pages and a real 404 for missing files.
    "not_found_handling": "none",
    // Default is "auto-trailing-slash" (redirects /explore -> /explore/),
    // which forces a 307 round-trip on every visit that arrives via a bare
    // URL — the common case, since nobody types or shares a trailing slash.
    // "drop-trailing-slash" serves /explore directly and instead redirects
    // the other way (/explore/ -> /explore), matching the no-trailing-slash
    // canonical convention in src/seo/useSeoMeta.ts and public/sitemap.xml.
    // Assets answer that with a 307 (temporary), which kept /es/ and /es
    // indexed as separate pages; a dashboard Redirect Rule ("Quitar barra
    // final": https://dofusforge.com/*/ -> https://dofusforge.com/${1}, 301)
    // runs first and makes it permanent. A second one sends www.* to the
    // apex with a 301 (www is an AAAA 100:: proxied record, redirect-only).
    "html_handling": "drop-trailing-slash",
    // Prerendered builds and profiles can turn private or be deleted after a
    // deploy: these paths go through the Worker, which checks before serving
    // the file (src/worker/index.ts serveBuildPage / serveProfilePage).
    "run_worker_first": ["/build/*", "/*/build/*", "/u/*", "/*/u/*"],
    "binding": "ASSETS"
  },
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],
  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "dofus-forge-assets" },
    // Rendered share cards (src/worker/ogRender.ts keys). Private on purpose:
    // no custom domain or r2.dev URL, so a build's card is only reachable
    // through the Worker's visibility check. Set/class cards are overwritten in
    // place (scripts/og-pregenerate.ts); a lifecycle rule expires build cards
    // (v1/builds/, keyed by updated_at) after 60 days, re-rendered if requested.
    { "binding": "OG_BUCKET", "bucket_name": "dofus-forge-og" }
  ],
  "vars": {
    "SUPABASE_URL": "https://wkllwjxodqxhiptjaccj.supabase.co"
  },
  "previews": {},
  // Workers Logs (dashboard → Observability). Kept here, not only in the
  // dashboard: each deploy applies this file and would switch it back off.
  // One event per invocation plus each console.* line; the Free plan stores
  // 200,000 a day and then stops storing until 00:00 UTC, it never bills.
  // Static files don't invoke the Worker, so only Worker routes count
  // (~30k invocations a day). Lower head_sampling_rate if that grows.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
